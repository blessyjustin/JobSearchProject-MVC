@model JobSearchProject_MVC.Models.login

@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="login-page">
    <div class="login-card">
        <h2>Welcome Back</h2>
        <p>Login to continue to Job Finder.</p>

        @using (Html.BeginForm("login_click", "login", FormMethod.Post))
        {
            <div class="form-group">
                <label>Username</label>
                @Html.TextBoxFor(m => m.username, new { @class = "form-input", placeholder = "Enter username" })
                @Html.ValidationMessageFor(m => m.username, "", new { @class = "validation-error" })
            </div>

            <div class="form-group">
                <label>Password</label>
                @Html.PasswordFor(m => m.password, new { @class = "form-input", placeholder = "Enter password" })
                @Html.ValidationMessageFor(m => m.password, "", new { @class = "validation-error" })
            </div>

            if (!string.IsNullOrEmpty(Model?.msg))
            {
                <div class="login-error">
                    @Model.msg
                </div>
            }

            <button type="submit" class="register-button">Login</button>

            <p class="login-link">
                Don't have an account?
                <a href="@Url.Action("Index", "Registration")">Register here</a>
            </p>
        }
    </div>
</div>