@model JobSearchProject_MVC.Models.postjob
@{
    ViewBag.Title = "postjob_pageload";
    Layout = "~/Views/Shared/_EmployerLayout.cshtml";
}

<div class="post-job-page">
    <div class="post-job-header">
        <h1>Post a New Job</h1>
        <p>Find the right talent for your company.</p>
    </div>

    <div class="post-job-card">
        <h2>Job Details</h2>
        <p class="post-job-subtitle">Fill in the details below to publish your job.</p>

        @using (Html.BeginForm("postjob_click", "postjob", FormMethod.Post))
        {
            <div class="post-job-grid">
                <div class="post-job-field">
                    <label for="title">Job Title *</label>
                    @Html.TextBoxFor(m => m.title, new
                    {
                        @class = "post-job-input",
                    })
                    @Html.ValidationMessageFor(m => m.title)
                </div>

                <div class="post-job-field">
                    <label for="job_type">Job Type *</label>
                    @Html.DropDownListFor(m => m.job_type,
                        new SelectList(new[]
                        {
                            new { Value = "", Text = "Select job type" },
                            new { Value = "Full-Time", Text = "Full-Time" },
                            new { Value = "Part-Time", Text = "Part-Time" },
                            new { Value = "Internship", Text = "Internship" },
                            new { Value = "Contract", Text = "Contract" }
                        }, "Value", "Text"),
                        new { @class = "post-job-input" })
                    @Html.ValidationMessageFor(m => m.job_type)
                </div>

                <div class="post-job-field">
                    <label for="experience">Experience Required *</label>
                    @Html.DropDownListFor(m => m.experience,
                        new SelectList(new[]
                        {
                            new { Value = "", Text = "Select experience" },
                            new { Value = "Fresher", Text = "Fresher" },
                            new { Value = "0-1 years", Text = "0-1 years" },
                            new { Value = "1-3 years", Text = "1-3 years" },
                            new { Value = "3-5 years", Text = "3-5 years" },
                            new { Value = "5+ years", Text = "5+ years" }
                        }, "Value", "Text"),
                        new { @class = "post-job-input" })
                    @Html.ValidationMessageFor(m => m.experience)
                </div>

                <div class="post-job-field">
                    <label for="location">Location *</label>
                    @Html.TextBoxFor(m => m.location, new
                    {
                        @class = "post-job-input"
                    })
                    @Html.ValidationMessageFor(m => m.location)
                </div>

                <div class="post-job-field">
                    <label for="salary">Salary Range</label>
                    @Html.TextBoxFor(m => m.salary, new
                    {
                        @class = "post-job-input"
                    })
                </div>

                <div class="post-job-field">
                    <label for="skills">Required Skills *</label>
                    @Html.TextBoxFor(m => m.skills, new
                    {
                        @class = "post-job-input"      
                    })
                    @Html.ValidationMessageFor(m => m.skills)
                </div>

                <div class="post-job-field post-job-full">
                    <label for="description">Job Description *</label>
                    @Html.TextAreaFor(m => m.description, new
                    {
                        @class = "post-job-input post-job-textarea"
                    })
                    @Html.ValidationMessageFor(m => m.description)
                </div>

            </div>

            <div class="post-job-actions">
                <button type="reset" class="post-job-cancel">
                    Clear Form
                </button>
                <button type="submit" class="post-job-submit">
                    Publish Job
                </button>
            </div>
            <div class="success-message">
                @Html.DisplayFor(m => m.msg)
            </div>
        }
    </div>
</div>
