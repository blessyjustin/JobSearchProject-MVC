
@{
    ViewBag.Title = "Find Jobs";
    Layout = "~/Views/Shared/_JobSeekerLayout.cshtml";
}

<div class="jobseeker-page">
    <div class="jobseeker-header">
        <h1>Find Your Dream Job</h1>
        <p>Explore opportunities and take the next step in your career.</p>
    </div>


    <div class="job-search-card">
        <h2>Search Jobs</h2>

        @using (Html.BeginForm("JobSeeker_pageload", "JobSeeker", FormMethod.Get))
        {
            <div class="job-search-grid">

                <div class="job-search-field">
                    <label>Job Title</label>
                    <input type="text" name="title"value="@Request.QueryString["title"]"placeholder="Enter job title" />
                </div>

                <div class="job-search-field">
                    <label>Experience</label>
                    <select name="experience">
                        <option value=""
                                @(Request.QueryString["experience"] == "" || Request.QueryString["experience"] == null ? "selected" : "")>
                            All Experience
                        </option>

                        <option value="Fresher"
                                @(Request.QueryString["experience"] == "Fresher" ? "selected" : "")>
                            Fresher
                        </option>

                        <option value="0-1 years"
                                @(Request.QueryString["experience"] == "0-1 years" ? "selected" : "")>
                            0-1 years
                        </option>

                        <option value="1-3 years"
                                @(Request.QueryString["experience"] == "1-3 years" ? "selected" : "")>
                            1-3 years
                        </option>

                        <option value="3-5 years"
                                @(Request.QueryString["experience"] == "3-5 years" ? "selected" : "")>
                            3-5 years
                        </option>

                        <option value="5+ years"
                                @(Request.QueryString["experience"] == "5+ years" ? "selected" : "")>
                            5+ years
                        </option>
                    </select>
                </div>

                <div class="job-search-field">
                    <label>Salary</label>
                    <input type="text" name="salary"
                           value="@Request.QueryString["salary"]"
                           placeholder="Enter salary" />
                </div>

                <div class="job-search-field">
                    <label>Location</label>
                    <input type="text" name="location"
                           value="@Request.QueryString["location"]"
                           placeholder="Enter location" />
                </div>

                <button type="submit" class="job-search-button">
                    Search
                </button>

            </div>
        }
    </div>


    @using (Html.BeginForm("JobSeeker_pageload", "JobSeeker", FormMethod.Get))
    {
        <div class="job-table-card">
            <div class="job-table-wrapper">
                <table class="job-table">
                    <thead>
                        <tr>
                            <th>Job Details</th>
                            <th>Company</th>
                            <th>Location</th>
                            <th>Experience</th>
                            <th>Salary</th>
                            <th>Job Type</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.alljobs != null)
                        {
                            foreach (var item in ViewBag.alljobs)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.title</strong>
                                        <span class="job-skills">@item.skills</span>
                                    </td>
                                    <td>@item.CompanyName</td>
                                    <td>@item.location</td>
                                    <td>@item.experience</td>
                                    <td>₹ @(string.IsNullOrEmpty(item.salary) ? "Not specified" : item.salary)</td>
                                    <td>
                                        <span class="job-type">@item.job_type</span>
                                    </td>
                                    <td>
                                        @Html.ActionLink("Apply Now", "ApplyNow", "JobSeeker", new { id = item.job_id }, new { @class = "apply-job-button" })
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

